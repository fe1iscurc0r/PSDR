# Reproduce the Eclipse CDT Debug build of the F7 firmware on Linux.
#
# Source: PSDR_F7 @ ab2c8fd (2018-07-31), the branch the maintainer named as the
#   firmware base on 2026-11-03 (#19). Re-based from PSDR_Rebuild on 2026-11-03;
#   the port cost was zero -- the rules below were not touched for the re-base
#   (only this comment block was corrected) and the tree builds as-is
#   with GCC 13.2.1: rc=0, 0 errors, 0 undefined references.
#   Compiler/link flags were transcribed originally from PSDR_Rebuild's
#   Source/.cproject Debug config: Cortex-M7 / Thumb / hard float fpv5-sp-d16,
#   -O0, --gc-sections, HSE_VALUE=26000000, defines DEBUG TRACE USE_FULL_ASSERT
#   __FPU_PRESENT ARM_MATH_CM7 STM32F746xx USE_HAL_DRIVER. On PSDR_F7's own
#   .cproject the two values that overlap check out (HSE_VALUE=26000000 and
#   --gc-sections are present); its source-entry exclusions do NOT match what
#   this harness does -- see item f) below, which also carries the measured
#   comparison. OPT defaults to -O0 and can be overridden (e.g. OPT=-Os).
#
# Deliberate differences from the Eclipse build (all visible, none silent):
#   a) -fcommon: GCC 10+ defaults to -fno-common; this tree has tentative
#      definitions in headers. Restores the original GCC 4.7 semantics.
#   b) all three linker scripts are passed together (mem/libs/sections).
#   c) .S sources get their own rule; arm_bitreversal2.S defines
#      arm_bitreversal_32 needed by the FFT code.
#   d) OS_INCLUDE_STARTUP_INIT_MULTIPLE_RAM_SECTIONS is applied only to
#      _startup.c, matching the fileInfo override in .cproject.
#   e) (historical) while this harness built the PSDR_Rebuild mirror it needed
#      two include fixes in src/si5338.c and src/frequency_control.c to compile
#      under GCC 13. Those files do not exist on PSDR_F7 (the Si5338 driver is
#      inside the 825-line src/i2c.c there), so after the 2026-11-03 re-base
#      there are **no source edits at all** in Source_F7 except this makefile
#      and the two .gitignore lines.
#   f) exclusion policy. PSDR_F7's own Eclipse Debug config excludes
#      DSP_Lib/Examples plus 42 files under system/src/stm32f7-hal (the list
#      starts at .cproject line 232; it drops hal_dma.c, but keeps hal_i2c.c,
#      hal_uart.c, hal_tim.c, hal_spi.c, hal_adc.c, hal_dac.c, hal_gpio.c and
#      hal_rcc.c) and it does NOT exclude src/TinyGPS.c. This harness instead
#      compiles every HAL source except stm32f7xx_hal_msp_template.c (which
#      would duplicate the MSP symbols that src/stm32f7xx_hal_msp.c defines)
#      and skips TinyGPS.c. Measured with GCC 13.2.1, all three policies agree
#      after --gc-sections:
#        as committed here (all HAL, no TinyGPS)      text 114068 data 18488 bss 18260
#        TinyGPS compiled, all HAL                    text 114064 data 18488 bss 18260
#        TinyGPS compiled + the 42 Debug exclusions   text 114064 data 18488 bss 18260
#      All three build clean (rc=0, 0 errors, 0 undefined references), so the
#      superset here is a convenience, not a hidden behavioural difference.
#      Sizes are reported equal; that is not a claim of byte-identical images.
#
# Measured with GCC 13.2.1 on the re-based tree (2026-11-03):
#   text 114068 / data 18488 / bss 18260, build_linux_f7/PSDR.hex 372,928 B.
#   Anchor gate passes against both committed references now kept in
#   dist/reference/ -- initial SP 0x20050000 and empty-slot pattern
#   [7, 8, 9, 10, 13, 95]; reset values are reported, not gated (the layout
#   moves), and only 7/118 vector words match, which is the expected
#   old-toolchain-vs-GCC-13 difference, not a mis-build.
#   For the previous baseline: the same source built from PSDR_Rebuild gave
#   -O0 112,344 B (-Og 93,704, -O2 93,268, -Os 89,748) versus 76,837 B in the
#   2018-06-21 hex, which looks like an optimized build from an older GCC.

TARGET=PSDR
BUILD=build_linux_f7
PREFIX=arm-none-eabi-
CC=$(PREFIX)gcc
CP=$(PREFIX)objcopy
SZ=$(PREFIX)size
CPU=-mcpu=cortex-m7 -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16
DEFS=-DDEBUG -D__FPU_PRESENT -DARM_MATH_CM7 -DUSE_FULL_ASSERT -DTRACE \
     -DOS_USE_TRACE_SEMIHOSTING_DEBUG -DSTM32F746xx -DUSE_HAL_DRIVER -DHSE_VALUE=26000000
INCS=-Iinclude -Isystem/include -Isystem/include/cmsis -Isystem/include/stm32f7-hal -Ildscripts
OPT?=-O0
CFLAGS=$(CPU) $(DEFS) $(INCS) -std=gnu99 $(OPT) -fcommon -ffunction-sections -fdata-sections \
       -fsigned-char -ffreestanding -fno-move-loop-invariants -Wall --specs=nano.specs

GC?=1
LDSCRIPTS=-Tldscripts/mem.ld -Tldscripts/libs.ld -Tldscripts/sections.ld
LDFLAGS=$(CPU) $(LDSCRIPTS) -nostartfiles
ifeq ($(GC),1)
LDFLAGS+=-Wl,--gc-sections
endif
LIBS=-lc -lm -lnosys

SRC_EXCLUDE = src/TinyGPS.c

# HEAD's .cproject includes every HAL source, but the MSP template defines the
# same HAL_MspInit/HAL_MspDeInit symbols as src/stm32f7xx_hal_msp.c.
HAL_EXCLUDE = system/src/stm32f7-hal/stm32f7xx_hal_msp_template.c

DSP_DIRS = $(wildcard DSP_Lib/Source/*)

C_SRCS  = $(filter-out $(SRC_EXCLUDE),$(wildcard src/*.c))
C_SRCS += $(filter-out $(HAL_EXCLUDE),$(wildcard system/src/stm32f7-hal/*.c))
C_SRCS += $(wildcard system/src/cmsis/*.c)
C_SRCS += $(wildcard system/src/diag/*.c)
C_SRCS += $(wildcard system/src/cortexm/*.c)
C_SRCS += $(wildcard system/src/newlib/*.c)
C_SRCS += $(wildcard $(addsuffix /*.c,$(DSP_DIRS)))

ASM_SRCS = $(wildcard DSP_Lib/Source/TransformFunctions/*.S)

VPATH = src:system/src/stm32f7-hal:system/src/cmsis:system/src/diag:system/src/cortexm:system/src/newlib:$(DSP_DIRS)
OBJDIR=$(BUILD)/obj
OBJS=$(addprefix $(OBJDIR)/,$(C_SRCS:.c=.o))
OBJS+=$(addprefix $(OBJDIR)/,$(ASM_SRCS:.S=.o))

$(OBJDIR)/system/src/newlib/_startup.o: CFLAGS += -DOS_INCLUDE_STARTUP_INIT_MULTIPLE_RAM_SECTIONS

all: $(BUILD)/$(TARGET).elf $(BUILD)/$(TARGET).hex $(BUILD)/$(TARGET).bin

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(CPU) -c $< -o $@

$(BUILD)/$(TARGET).elf: $(OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(LDFLAGS) $(OBJS) $(LIBS) -Wl,-Map=$(BUILD)/$(TARGET).map -o $@

$(BUILD)/$(TARGET).hex: $(BUILD)/$(TARGET).elf
	$(CP) -O ihex $< $@
	$(SZ) $<

$(BUILD)/$(TARGET).bin: $(BUILD)/$(TARGET).elf
	$(CP) -O binary $< $@

REF?=Debug/PSDR.hex

anchors: $(BUILD)/$(TARGET).elf
	$(PREFIX)objcopy -O binary --only-section=.isr_vector $< $(BUILD)/$(TARGET).vectors.bin
	@echo "initial SP / reset vector from ELF:"
	@od -An -tx4 -N8 $(BUILD)/$(TARGET).vectors.bin
	$(PREFIX)nm $< | grep -E "_estack|Reset_Handler"
	@echo "reference hex: $(REF)"

clean:
	rm -rf $(BUILD)

.PHONY: all clean anchors
